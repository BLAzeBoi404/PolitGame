<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sovereign</AssemblyName>
    <Version>0.19.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.2</LangVersion>
    <ApplicationIcon>assets/app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Reference Include="OpenTK"><HintPath>lib/OpenTK.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="OpenTK.GLControl"><HintPath>lib/OpenTK.GLControl.dll</HintPath><Private>true</Private></Reference>
    <None Include="lib/OpenTK.dll.config" Link="OpenTK.dll.config" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml" />
    <EmbeddedResource Include="assets/flags.png" LogicalName="flags.png" />
    <EmbeddedResource Include="assets/flag-codes.tsv" LogicalName="flag-codes.tsv" />
    <EmbeddedResource Include="assets/world.bin" LogicalName="world.bin" />
    <EmbeddedResource Include="assets/scenario-military-quality.tsv" LogicalName="scenario-military-quality.tsv" />
    <EmbeddedResource Include="assets/scenario-countries.tsv" LogicalName="scenario-countries.tsv" />
    <EmbeddedResource Include="assets/scenario-regions.tsv" LogicalName="scenario-regions.tsv" />
    <EmbeddedResource Include="assets/scenario-adjacency.tsv" LogicalName="scenario-adjacency.tsv" />
  </ItemGroup>
</Project>
